{
  "name": "pocket-master-editor",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "npm run dev -w @pocket-master/web",
    "build": "npm run build -w @pocket-master/web && npm run build -w sonicake-pocket-master-mcp",
    "e2e": "npm run e2e -w @pocket-master/web",
    "e2e:live": "npm run e2e:live -w @pocket-master/web"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.9"
  }
}
